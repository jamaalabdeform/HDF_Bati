# ==========================================================
# HDF Bâti — variables d'environnement
# Copier en .env.local (dev) ou les déclarer chez l'hébergeur.
# ==========================================================

# --- Site -------------------------------------------------
# URL publique canonique, sans / final (canonical, sitemap, OpenGraph, schema.org)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | preview | development
#  - production : placeholders [À CONFIRMER AVEC FARID] masqués, indexation autorisée,
#                 un connecteur de lead (CRM ou notification) devient OBLIGATOIRE
#  - preview    : placeholders visibles, noindex
NEXT_PUBLIC_SITE_ENV=preview

# --- WhatsApp ---------------------------------------------
# Numéro international sans + ni espaces (ex. 33601451110)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Mesure (chargée uniquement après consentement) -------
NEXT_PUBLIC_GTM_ID=
# GA4 direct, utilisé seulement si GTM n'est pas renseigné
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Balise de validation Google Search Console (contenu du meta google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=
# true = journalise les événements analytics dans la console en production
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# --- Leads (serveur uniquement, jamais exposé au navigateur) ---
# Webhook CRM : reçoit le lead complet (JSON)
CRM_WEBHOOK_URL=
# Webhook d'alerte WhatsApp Farid (Make / n8n / WhatsApp Cloud API)
LEAD_NOTIFY_WEBHOOK_URL=
# Secret partagé : en-tête X-HDF-Signature = sha256(secret + corps)
LEAD_WEBHOOK_SECRET=

# --- Meta Conversions API (serveur) -----------------------
META_PIXEL_ID=
META_CAPI_TOKEN=
# Code de test (Gestionnaire d'événements) — vide en production
META_CAPI_TEST_CODE=
